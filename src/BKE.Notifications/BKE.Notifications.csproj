<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BKE.Notifications</RootNamespace>
    <AssemblyName>BKE.Notifications</AssemblyName>
    <PackageId>BKE.Notifications</PackageId>
    <Version>0.4.0</Version>
    <PackageVersion>0.4.0</PackageVersion>
    <Authors>BKE Digital Solutions</Authors>
    <Description>Product-neutral software-side notification capability contracts.</Description>
    <PackageReleaseNotes>Adds least-privilege publish, feed, lifecycle, and unread-count capability interfaces while preserving INotificationClient as the full composite contract and keeping transport, persistence, UI, and producer authentication outside the portable package.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/jan2xo/bke-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE-BKE-PROPRIETARY.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../LICENSE-BKE-PROPRIETARY.txt" Pack="true" PackagePath="LICENSE-BKE-PROPRIETARY.txt" />
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>