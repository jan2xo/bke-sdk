<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BKE.Notifications</RootNamespace>
    <AssemblyName>BKE.Notifications</AssemblyName>
    <PackageId>BKE.Notifications</PackageId>
    <Version>0.5.0</Version>
    <PackageVersion>0.5.0</PackageVersion>
    <Authors>BKE Digital Solutions</Authors>
    <Description>Product-neutral notification contracts with a least-privilege Licensing Agent inbox provider.</Description>
    <PackageReleaseNotes>Adds BkeNotificationInboxClient for Agent-backed feed, read, dismiss, and unread-count operations. Publishing remains intentionally excluded from the concrete product-facing provider.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/jan2xo/bke-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE-BKE-PROPRIETARY.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../LICENSE-BKE-PROPRIETARY.txt" Pack="true" PackagePath="LICENSE-BKE-PROPRIETARY.txt" />
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>