<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BKE.Desktop.Licensing</AssemblyName>
    <RootNamespace>BKE.Desktop.Licensing</RootNamespace>

    <Version>2.0.1</Version>
    <PackageId>BKE.Desktop.Licensing</PackageId>
    <PackageTitle>BKE Desktop Licensing SDK</PackageTitle>
    <Authors>BKE Digital Solutions</Authors>
    <Description>Typed .NET 10 licensing capability for BKE desktop products, including authorization and Agent-owned activation presentation.</Description>
    <PackageTags>bke;desktop;sdk;licensing;licensing-agent;dotnet</PackageTags>
    <PackageReleaseNotes>Recover signed-but-stale licensing authority through the Agent-owned License Center while preserving fail-closed authorization.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/jan2xo/bke-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE-BKE-PROPRIETARY.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BKE.Desktop.Licensing.Tests" />
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE-BKE-PROPRIETARY.txt" Pack="true" PackagePath="LICENSE-BKE-PROPRIETARY.txt" />
  </ItemGroup>
</Project>
